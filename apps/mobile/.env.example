# Copy to .env. Only EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
#
# iOS simulator / web:   http://localhost:4000/api/v1
# Android emulator:      http://10.0.2.2:4000/api/v1
# Physical device:       http://<your computer's LAN IP>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
