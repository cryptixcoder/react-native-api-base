# Test-only values (safe to commit). Used by `pnpm test:integration` and `pnpm db:test:prepare`.
NODE_ENV=test
PORT=4001
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/app_test?schema=public"
REDIS_URL="redis://localhost:6379"
QUEUE_PREFIX="myapp-test"
API_URL="http://localhost:4001"
MOBILE_APP_URL="myapp://"
CORS_ORIGINS="http://localhost:8081"
LOG_LEVEL="silent"
JWT_ACCESS_SECRET="test-access-secret-that-is-long-enough-1234567890"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Test <test@example.com>"
EMAIL_VERIFICATION_EXPIRES_IN_HOURS="24"
PASSWORD_RESET_EXPIRES_IN_MINUTES="30"
