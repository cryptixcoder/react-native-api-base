{
  "name": "api",
  "version": "1.0.0",
  "description": "Express REST API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "check-types": "tsc --noEmit",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "pnpm test --watch",
    "test:coverage": "pnpm test --coverage",
    "test:integration": "dotenv run -f .env.test --override -q -- node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "test:ci": "pnpm test --ci --coverage",
    "db:test:prepare": "dotenv run -f .env.test --override -q -- pnpm --filter @repo/database exec prisma migrate deploy"
  },
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/database": "workspace:*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@repo/tsconfig": "workspace:*",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-mock-extended": "^4.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "3.9.6",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
