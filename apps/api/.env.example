NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

API_URL="http://localhost:4000"
# Base URL for links in emails that open the mobile app (must match the "scheme" in apps/mobile/app.json).
# Use a universal / app link such as https://app.example.com/ in production.
MOBILE_APP_URL="myapp://"

# Comma-separated browser origins (Expo web dev server runs on 8081). Native apps don't need CORS.
CORS_ORIGINS="http://localhost:8081"
LOG_LEVEL="debug"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"

# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# Leave empty in development to log email links instead of sending them. Required in production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="My App <noreply@example.com>"

EMAIL_VERIFICATION_EXPIRES_IN_HOURS="24"
PASSWORD_RESET_EXPIRES_IN_MINUTES="30"
